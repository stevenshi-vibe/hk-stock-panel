# User-specific stock data and southbound index / upstream caches.
# 不要提交个股库、南下索引，或以后误放到这里的抓取结果。
data/**
!data/.gitkeep
backend/fixtures/southbound/raw/
backend/fixtures/southbound/cache/
uploads/*
!uploads/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
backend/backend.log

# Node source deps (dist will be committed for easy deployment)
frontend/node_modules/

# OS
.DS_Store

# User-specific config (copy from config.example.json)
backend/config.json
frontend/tsconfig.tsbuildinfo
backend/knowledge_base/custom_*.md

# User-specific stock attribution seeds (may contain private data)
scripts/seed_02718_attribution.py
scripts/*_local*.py
